static void requestSkill() {
    viewSkills();

    if (skills.isEmpty())
        return;

    System.out.print("Select service number: ");
    int choice = sc.nextInt();
    sc.nextLine();

    if (choice >= 1 && choice <= skills.size()) {
        System.out.println(
            "Service requested: "
            + skills.get(choice - 1)
        );
    } else {
        System.out.println("Invalid choice.");
    }
}